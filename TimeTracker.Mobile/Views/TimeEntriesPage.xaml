<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:TimeTracker.Mobile.Converters"
             xmlns:resx="clr-namespace:TimeTracker.Mobile.Resources.Strings"
             x:Class="TimeTracker.Mobile.Views.TimeEntriesPage">

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">
            <StackLayout Padding="10">
                <!-- BOUTON “Retour à l’Accueil” -->
                <Button 
                    Text="{x:Static resx:AppResources.TimeEntries_BackToHome}"  
                    Clicked="OnBackToHomeClicked" 
                    HorizontalOptions="Start"
                    AutomationProperties.Name="{x:Static resx:AppResources.TimeEntries_BackToHome}" />

                <Label 
                    Text="{x:Static resx:AppResources.TimeEntries_Title}" 
                    FontAttributes="Bold" 
                    FontSize="20"
                    AutomationProperties.Name="{x:Static resx:AppResources.TimeEntries_Title}" />
                <CollectionView ItemsSource="{Binding TimeEntries}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10" Margin="5" HasShadow="True" CornerRadius="12" BackgroundColor="#f8f8f8">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding SessionType}" FontAttributes="Bold" FontSize="18" TextColor="DarkBlue" />
                                    <Label Text="{Binding StartTime, Converter={StaticResource UtcToLocalConverter}, StringFormat='🕒 {0:dd/MM/yyyy HH:mm}'}" TextColor="DarkBlue" />
                                    <Label Text="{Binding EndTime, Converter={StaticResource UtcToLocalConverter}, StringFormat='🏁 {0:dd/MM/yyyy HH:mm}'}" TextColor="DarkBlue" />
                                    <!-- Durée totale -->
                                    <Label
                                      Text="{Binding WorkDuration, StringFormat={x:Static resx:AppResources.TimeEntries_TotalDuration}}"
                                      IsVisible="{Binding WorkDuration}" />

                                    <!-- Pause totale -->
                                    <Label
                                      Text="{Binding TotalPauseDuration, StringFormat={x:Static resx:AppResources.TimeEntries_TotalPause}}"
                                      IsVisible="{Binding TotalPauseDuration}" />

                                    <!-- Trajet inclus -->
                                    <Label
                                        Text="{Binding IncludesTravelTime, StringFormat={x:Static resx:AppResources.TimeEntries_TravelIncluded}}"/>

                                    <!-- Temps de trajet estimé -->
                                    <Label
                                      Text="{Binding TravelTimeEstimate, StringFormat={x:Static resx:AppResources.TimeEntries_TravelTime}}"
                                      IsVisible="{Binding IncludesTravelTime}" />

                                    <!-- Adresses -->
                                    <Label
                                        Text="{Binding StartAddress, StringFormat={x:Static resx:AppResources.TimeEntries_StartAddress}}" />
                                    <Label
                                        Text="{Binding EndAddress, StringFormat={x:Static resx:AppResources.TimeEntries_EndAddress}}" />

                                    <Label Text="{Binding DinnerPaid, StringFormat='{x:Static resx:AppResources.TimeEntries_DinnerPaid}'}" TextColor="DarkBlue" />
                                </VerticalStackLayout>

                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label Text="Aucune session terminée à afficher"
                   FontAttributes="Italic"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="{Binding IsEmpty}" />

            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>