            </button>
        </h2>
        <div id="c2" class="accordion-collapse collapse" aria-labelledby="p2" data-bs-parent="#privacyAccordion">
            <div class="accordion-body">
                <ul>
                    <li>@SharedLocalizer["Privacy_S2_Item_Accounts"]</li>
                    <li>@SharedLocalizer["Privacy_S2_Item_Security"]</li>
