@page
@model TimeTracker.AdminUI.Pages.PrivacyModel
@using Microsoft.Extensions.Localization

@{
    ViewData["Title"] = SharedLocalizer["Privacy_Title"];
}

<h1 class="mb-4">@SharedLocalizer["Privacy_Title"]</h1>

<div class="accordion" id="privacyAccordion">

    <div class="accordion-item">
        <h2 class="accordion-header" id="p1">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#c1" aria-expanded="true" aria-controls="c1">
                @SharedLocalizer["Privacy_S1_Title"]
            </button>
        </h2>
        <div id="c1" class="accordion-collapse collapse show" aria-labelledby="p1" data-bs-parent="#privacyAccordion">
            <div class="accordion-body">
                @* Exemple avec placeholder {0} pour le nom de l’éditeur *@
                @SharedLocalizer["Privacy_S1_Body", "Ridialass"]
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header" id="p2">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#c2" aria-expanded="false" aria-controls="c2">
