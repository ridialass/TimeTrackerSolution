@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.Extensions.Localization


<ul class="navbar-nav ms-auto">
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <li class="nav-item">
            <form method="post" asp-page="/Account/Logout" class="d-inline">
                <button type="submit" class="nav-link btn btn-link">@SharedLocalizer["LogoutButton"]</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a asp-page="/Account/Login" class="nav-link">@SharedLocalizer["LoginButton"]</a>
        </li>
    }
</ul>