@page
@model ErrorModel
@using Microsoft.Extensions.Localization


@{
    ViewData["Title"] = ViewLocalizer["ErrorTitle"];
}

<h1 class="text-danger">@ViewLocalizer["ErrorHeader"]</h1>
<h2 class="text-danger">@ViewLocalizer["ErrorOccurredMessage"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@ViewLocalizer["RequestIdLabel"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@ViewLocalizer["DevelopmentModeHeader"]</h3>
<p>
    @ViewLocalizer["DevelopmentModeInfo"]
</p>
<p>
    <strong>@ViewLocalizer["DevelopmentWarningHeader"]</strong>
    @ViewLocalizer["DevelopmentWarningBody"]
</p>