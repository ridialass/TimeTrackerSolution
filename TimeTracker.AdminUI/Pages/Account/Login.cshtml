@page
@using Microsoft.Extensions.Localization
@model TimeTracker.AdminUI.Pages.Account.LoginModel
@{
    ViewData["Title"] = SharedLocalizer["LoginTitle"];
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">

            <div class="text-center mb-4">
                <h1 class="h3 fw-bold mb-1">TimeTracker</h1>
                <p class="text-muted m-0">€€ time  ££ is $$ money</p>
            </div>

            <form method="post" class="p-4 border rounded-3 bg-body-tertiary shadow-sm">
                <input type="hidden" asp-antiforgery="true" />

                <!-- résumé des erreurs -->
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert" style="display:none"></div>

                <!-- Username -->
                <div class="form-floating mb-3">
                    <input asp-for="Username"
                           class="form-control"
                           id="login-username"
                           placeholder="username"
                           autocomplete="username"
                           spellcheck="false"
                           autofocus />
                    <label for="login-username">@SharedLocalizer["UsernameLabel"]</label>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <!-- Password + eye toggle -->
                <div class="form-floating mb-3 position-relative">
                    <input asp-for="Password"
                           type="password"
                           class="form-control pe-5"
                           id="login-password"
                           placeholder="••••••••"
                           autocomplete="current-password" />
                    <label for="login-password">@SharedLocalizer["PasswordLabel"]</label>
                    <button type="button"
                            class="btn btn-link position-absolute top-50 end-0 translate-middle-y me-2 p-0"
                            aria-label="Toggle password visibility"
                            id="btn-toggle-password">
                        <i class="bi bi-eye" id="eye-icon"></i>
                    </button>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                @* message d’erreur renvoyé par le modèle *@
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        @SharedLocalizer[Model.ErrorMessage]
                    </div>
                }

                <!-- Remember me (visuel uniquement si non supporté côté modèle) -->
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="remember-me">
                    <label class="form-check-label" for="remember-me">
                        @SharedLocalizer["RememberMe"]
                    </label>
                </div>

                <button class="w-100 btn btn-primary btn-lg" id="btn-submit" type="submit">
                    @SharedLocalizer["LoginButton"]
                </button>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <a class="small" asp-page="/Account/ForgotPassword">
                        @SharedLocalizer["ForgotPasswordLink"]
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // affiche/masque le mot de passe
        (function () {
            const pwd = document.getElementById('login-password');
            const btn = document.getElementById('btn-toggle-password');
            const icon = document.getElementById('eye-icon');
            if (pwd && btn && icon) {
                btn.addEventListener('click', function () {
                    const showing = pwd.type === 'text';
                    pwd.type = showing ? 'password' : 'text';
                    icon.classList.toggle('bi-eye');
                    icon.classList.toggle('bi-eye-slash');
                });
            }
        })();

        // évite le double-submit (UX)
        (function () {
            const form = document.querySelector('form[method="post"]');
            const submit = document.getElementById('btn-submit');
            if (form && submit) {
                form.addEventListener('submit', function () {
                    submit.disabled = true;
                    submit.classList.add('disabled');
                    // réactive si le navigateur empêche la navigation
                    setTimeout(() => { submit.disabled = false; submit.classList.remove('disabled'); }, 6000);
                });
            }
        })();

        // affiche le résumé si des erreurs serveur existent
        (function () {
            const summary = document.querySelector('[asp-validation-summary]');
            if (summary && summary.innerText.trim().length > 0) {
                summary.style.display = '';
            }
        })();
    </script>
}
