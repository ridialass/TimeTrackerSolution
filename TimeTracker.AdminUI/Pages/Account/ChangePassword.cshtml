@page
@using Microsoft.Extensions.Localization
@model TimeTracker.AdminUI.Pages.Account.ChangePasswordModel
@inject IStringLocalizer<TimeTracker.Core.Resources.Errors> Localizer

@{
    ViewData["Title"] = Localizer["ChangePasswordTitle"];
}

<h2>@ViewData["Title"]</h2>

<form method="post" class="mt-4">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.CurrentPassword" class="form-label">@Localizer["CurrentPasswordLabel"]</label>
        <input asp-for="Input.CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.NewPassword" class="form-label">@Localizer["NewPasswordLabel"]</label>
        <input asp-for="Input.NewPassword" type="password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label">@Localizer["ConfirmPasswordLabel"]</label>
        <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-danger">@Model.Message</div>
    }

    <button type="submit" class="btn btn-primary">@Localizer["ChangePasswordButton"]</button>
    <a asp-page="/Account/Profile" class="btn btn-link">@Localizer["BackToProfileButton"]</a>
</form>