@page
@using Microsoft.Extensions.Localization
@model TimeTracker.AdminUI.Pages.Account.ProfileModel
@inject IStringLocalizer<TimeTracker.Core.Resources.Errors> Localizer

@{
    ViewData["Title"] = Localizer["ProfileTitle"];
    // Affichage : image par défaut SI PAS d'image utilisateur
    var photoUrl = !string.IsNullOrEmpty(Model.ProfilePictureUrl)
        ? Model.ProfilePictureUrl
        : Url.Content("~/images/default-profile.png");
}

<h2>@ViewData["Title"]</h2>

@if (!string.IsNullOrEmpty(Model.ProfileMessage))
{
    <div class="alert alert-success">@Model.ProfileMessage</div>
}

<div class="container text-center">
    
    <div class="row">
        <div class="col-8">
            <form method="post" enctype="multipart/form-data" asp-page-handler="UpdateProfile">
                <div class="mb-3">
                    <div class="row">
                        <div class="col-9">
                            @* <label class="form-label">@Localizer["ProfilePictureLabel"]</label><br /> *@
                            <img src="@photoUrl" alt="Avatar" style="width:100px;border-radius:50%;margin-bottom:10px;" />
                            <input asp-for="ProfilePicture" type="file" accept="image/*" class="form-control" />
                            <input type="hidden" asp-for="ProfilePictureUrl" />
                            <span asp-validation-for="ProfilePicture" class="text-danger"></span>
                        </div>                 
                        <div class="col-3">
                            <a asp-page="/Account/ChangePassword" class="btn btn-primary" style="margin-bottom:20px;">
                                @Localizer["ChangePasswordButton"]
                            </a>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="EditableEmail" class="form-label">@Localizer["EmailLabel"]</label>
                    <input asp-for="EditableEmail" class="form-control" />
                    <span asp-validation-for="EditableEmail" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label">@Localizer["FirstNameLabel"]</label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="LastName" class="form-label">@Localizer["LastNameLabel"]</label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Town" class="form-label">@Localizer["TownLabel"]</label>
                    <input asp-for="Town" class="form-control" />
                    <span asp-validation-for="Town" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Country" class="form-label">@Localizer["CountryLabel"]</label>
                    <input asp-for="Country" class="form-control" />
                    <span asp-validation-for="Country" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-success">@Localizer["SaveProfileButton"]</button>

            </form>
        </div>
        <div class="col-4">
            
        </div>
    </div>
</div>
