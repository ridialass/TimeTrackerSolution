@page
@model TimeTracker.AdminUI.Pages.Account.ResetPasswordByTokenModel
@{
    ViewData["Title"] = "Réinitialiser le mot de passe";
}

<h2>@ViewData["Title"]</h2>

@if (Model.Message != null)
{
    <div class="alert alert-info">@Model.Message</div>
}
else
{
    <form method="post" class="mt-4">
        <input type="hidden" asp-for="Token" />
        <input type="hidden" asp-for="Email" />

        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">Nouveau mot de passe</label>
            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Confirmer le mot de passe</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Réinitialiser</button>
        <a asp-page="/Account/Login" class="btn btn-link">Retour à la connexion</a>
    </form>
}
