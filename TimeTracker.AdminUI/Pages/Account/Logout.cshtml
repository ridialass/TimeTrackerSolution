@page
@using Microsoft.Extensions.Localization
@model TimeTracker.AdminUI.Pages.Account.LogoutModel
@{
    Layout = null;
    ViewData["Title"] = SharedLocalizer["LogoutTitle"];
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-5">
        <h2>@ViewData["Title"]</h2>

        @if (!string.IsNullOrEmpty(Model.InfoMessage))
        {
            <!-- Cas post-logout : message + retour accueil -->
            <div class="alert alert-info">@Model.InfoMessage</div>
            <a href="/" class="btn btn-primary">@SharedLocalizer["BackToHomeButton"]</a>
        }
        else
        {
            <!-- Cas GET : si l’utilisateur est encore authentifié, on lui propose de se déconnecter -->
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <p>@SharedLocalizer["LogoutMessage"]</p>
                <form method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        @SharedLocalizer["LogoutButton"]
                    </button>
                    <a href="/" class="btn btn-link">
                        @SharedLocalizer["BackToHomeButton"]
                    </a>
                </form>
            }
            else
            {
                <!-- Déjà déconnecté -->
                <div class="alert alert-secondary">
                    @SharedLocalizer["AlreadyLoggedOutMessage"]
                </div>
                <a href="/" class="btn btn-primary">@SharedLocalizer["BackToHomeButton"]</a>
            }
        }
    </div>
</body>
</html>
