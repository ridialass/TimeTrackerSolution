@page
@using Microsoft.Extensions.Localization
@model TimeTracker.AdminUI.Pages.Account.ForgotPasswordModel
@inject IStringLocalizer<TimeTracker.Core.Resources.Errors> Localizer

@{
    ViewData["Title"] = SharedLocalizer["ForgotPasswordTitle"];
}

<h2>@ViewData["Title"]</h2>

<form method="post" class="mt-4">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">@SharedLocalizer["EmailLabel"]</label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    @if (Model.Message != null)
    {
        <div class="alert alert-info">@Model.Message</div>
    }

    <button type="submit" class="btn btn-primary">@SharedLocalizer["SendResetLinkButton"]</button>
    <a asp-page="/Account/Login" class="btn btn-link">@SharedLocalizer["BackToLoginButton"]</a>
</form>