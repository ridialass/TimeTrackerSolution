@page
@model TimeTracker.AdminUI.Pages.Account.SessionModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TimeTracker.Core.Resources.Errors> Localizer

@{
    ViewData["Title"] = SharedLocalizer["MesSessionsTitle"] ?? "Mes Sessions";
    var period = Model.SelectedPeriod;
}

<h2>@ViewData["Title"]</h2>

<div class="card shadow-sm">
    <form method="get" class="row row-cols-lg-auto g-3 align-items-center">
        <div class="col">
            <label>@SharedLocalizer["PeriodLabel"] :</label>
            <select asp-for="SelectedPeriod" class="form-select" id="periodSelect" onchange="toggleCustomDates(this.value)">
                <option value="week" selected="@("week" == period)">@SharedLocalizer["ThisWeekOption"]</option>
                <option value="month" selected="@("month" == period)">@SharedLocalizer["ThisMonthOption"]</option>
                <option value="custom" selected="@("custom" == period)">@SharedLocalizer["CustomOption"]</option>
            </select>
        </div>
        <div class="col" id="customDates" style="display:none;">
            <label asp-for="CustomStartDate" class="form-label">@SharedLocalizer["FromLabel"]</label>
            <input asp-for="CustomStartDate" type="date" class="form-control" />
            <label asp-for="CustomEndDate" class="form-label">@SharedLocalizer["ToLabel"]</label>
            <input asp-for="CustomEndDate" type="date" class="form-control" />
        </div>
        <input type="hidden" asp-for="WeekOffset" />
        <input type="hidden" asp-for="MonthOffset" />
        <div class="col">
            <button type="submit" class="btn btn-primary">@SharedLocalizer["SubmitButton"]</button>
        </div>
    </form>
</div>

@if (period == "week")
{
    <div class="d-flex align-items-center gap-2 my-2">
        <form method="get" style="display:inline;">
            <input type="hidden" name="SelectedPeriod" value="week" />
            <input type="hidden" name="WeekOffset" value="@(Model.WeekOffset - 1)" />
            <button type="submit" class="btn btn-link">&laquo; @SharedLocalizer["PreviousWeekButton"]</button>
        </form>
        <span>
            @Model.CurrentWeekStart.ToString("dd/MM/yyyy") - @Model.CurrentWeekEnd.ToString("dd/MM/yyyy")
        </span>
        <form method="get" style="display:inline;">
            <input type="hidden" name="SelectedPeriod" value="week" />
            <input type="hidden" name="WeekOffset" value="@(Model.WeekOffset + 1)" />
            <button type="submit" class="btn btn-link">@SharedLocalizer["NextWeekButton"] &raquo;</button>

        </form>
    </div>
}
else if (period == "month")
{
    <div class="d-flex align-items-center gap-2 my-2">
        <form method="get" style="display:inline;">
            <input type="hidden" name="SelectedPeriod" value="month" />
            <input type="hidden" name="MonthOffset" value="@(Model.MonthOffset - 1)" />
            <button type="submit" class="btn btn-link">&laquo; @SharedLocalizer["PreviousMonthButton"]</button>
        </form>
        <span>
            @Model.CurrentMonthStart.ToString("MMMM yyyy")
        </span>
        <form method="get" style="display:inline;">
            <input type="hidden" name="SelectedPeriod" value="month" />
            <input type="hidden" name="MonthOffset" value="@(Model.MonthOffset + 1)" />
            <button type="submit" class="btn btn-link">@SharedLocalizer["NextMonthButton"] &raquo;</button>
        </form>
    </div>
}

@if (Model.Sessions != null && Model.Sessions.Any())
{
    <div class="card mt-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">@SharedLocalizer["SessionsForYou"]</h5>
            <div>
                @if (period == "week")
                {
                    <span class="badge text-bg-info">
                        @Model.CurrentWeekStart.ToString("dd/MM/yyyy") - @Model.CurrentWeekEnd.ToString("dd/MM/yyyy")
                    </span>
                }
                else if (period == "month")
                {
                    <span class="badge text-bg-info">
                        @Model.CurrentMonthStart.ToString("dd/MM/yyyy") - @Model.CurrentMonthEnd.ToString("dd/MM/yyyy")
                    </span>
                }
                else if (period == "custom")
                {
                    <span class="badge text-bg-info">
                        @(Model.CustomStartDate?.ToString("dd/MM/yyyy") ?? "—") - @(Model.CustomEndDate?.ToString("dd/MM/yyyy") ?? "—")
                    </span>
                }
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>@SharedLocalizer["SessionTypeLabel"]</th>
                            <th>@SharedLocalizer["StartTimeLabel"]</th>
                            <th>@SharedLocalizer["EndTimeLabel"]</th>
                            <th>@SharedLocalizer["WorkNetLabel"]</th>
                            <th>@SharedLocalizer["TravelTimeEstimateLabel"]</th>
                            <th>@SharedLocalizer["StartAddressLabel"]</th>
                            <th>@SharedLocalizer["EndAddressLabel"]</th>
                            <th>@SharedLocalizer["DinnerPaidLabel"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Sessions)
                        {
                            <tr>
                                <td>@SharedLocalizer[$"SessionType_{s.SessionType}"]</td>
                                <td>
                                    <span class="dt-local" data-dt="@s.StartTime.ToString("o")"></span>
                                </td>
                                <td>
                                    @if (s.EndTime.HasValue)
                                    {
                                        <span class="dt-local" data-dt="@s.EndTime.Value.ToString("o")"></span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>@(s.WorkDurationNetFormatted ?? "—")</td>
                                <td>@(s.TravelTimeEstimate.HasValue? s.TravelTimeEstimate.Value.ToString(@"hh\:mm") : "—")</td>
                                <td>@s.StartAddress</td>
                                <td>@s.EndAddress</td>
                                <td>@SharedLocalizer[$"DinnerPaidBy_{s.DinnerPaid}"]</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <p class="text-muted mt-4">@SharedLocalizer["NoSessionsMessage"]</p>
}

@section Scripts {
    <script>
        function toggleCustomDates(val) {
            document.getElementById('customDates').style.display = val === 'custom' ? 'flex' : 'none';
        }
        document.addEventListener('DOMContentLoaded', function() {
            toggleCustomDates(document.getElementById('periodSelect').value);
            // Affichage des dates/horaires en heure locale du navigateur
            document.querySelectorAll('.dt-local').forEach(function (el) {
                const raw = el.getAttribute('data-dt');
                if (raw) {
                    const date = new Date(raw);
                    el.textContent = date.toLocaleString();
                }
            });
        });
    </script>
}
