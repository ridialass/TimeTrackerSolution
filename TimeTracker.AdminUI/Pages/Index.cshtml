@page
@model TimeTracker.AdminUI.Pages.Index1Model
@using TimeTracker.Core.Resources
@{
    ViewData["Title"] = SharedLocalizer["HomeTitle"];
}
<div class="container py-4">
    <h1 class="mb-3">@SharedLocalizer["WelcomeTo"] TimeTracker</h1>

    @if (!(User?.Identity?.IsAuthenticated ?? false))
    {
        <p class="lead">@SharedLocalizer["NotAuthenticatedMessage"]</p>
        <a class="btn btn-primary" asp-page="/Account/Login">@SharedLocalizer["LoginButton"]</a>
    }
    else
    {
        <p class="lead">@SharedLocalizer["SignedInAs"] <strong>@User.Identity!.Name</strong>.</p>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin"))
            {
                <a class="btn btn-secondary" asp-page="/Admin/AdminDashboard">@SharedLocalizer["GoToAdmin"]</a>
            }
            else
            {
                <a class="btn btn-secondary" asp-page="/UserPage">@SharedLocalizer["GoToMyPage"]</a>
            }
            <a class="btn btn-outline-danger" asp-page="/Account/Logout">@SharedLocalizer["Logout"]</a>
        </div>
    }
</div>