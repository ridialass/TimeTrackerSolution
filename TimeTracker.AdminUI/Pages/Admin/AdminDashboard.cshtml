@page
@model TimeTracker.AdminUI.Pages.Admin.AdminDashboardModel
@using Microsoft.Extensions.Localization
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

@{
    ViewData["Title"] = SharedLocalizer["AdminDashboardTitle"];
}

@if (!(User?.Identity?.IsAuthenticated ?? false))
{
    <div class="alert alert-warning">
        <p>@SharedLocalizer["LoginRequiredMessage"]</p>
        <a href="/Account/Login" class="btn btn-primary">@SharedLocalizer["LoginButton"]</a>
    </div>
}
else if (!User.IsInRole("Admin"))
{
    <div class="alert alert-danger">
        <p>@SharedLocalizer["AccessDeniedMessage"]</p>
        <a href="/" class="btn btn-secondary">@SharedLocalizer["BackToHomeButton"]</a>
    </div>
}
else
{
    <div class="row g-4">
        <!-- 2. Filter Sessions by User and Date -->
        <div class="col-lg-12">
            <div class="card shadow-sm">
                <form method="post" asp-page-handler="LoadSessions" class="row row-cols-lg-auto g-3 align-items-center">
                    <div class="12">
                        <strong>@SharedLocalizer["FilterLabel"]</strong>
                    </div>
                    <div class="12">
                        @SharedLocalizer["EmployeeLabel"] :
                    </div>
                    <div class="col-12">
                        <label class="visually-hidden" for="inlineFormSelectPref">@SharedLocalizer["EmployeeLabel"]</label>
                        <select asp-for="SelectedEmployeeId" class="form-select">
                            <option value="0">-- @SharedLocalizer["SelectLabel"] --</option>
                            @foreach (var emp in Model.AllEmployees)
                            {
                                <option value="@emp.Id">@emp.Username</option>
                            }
                        </select>
                    </div>
                    <div class="12">
                        @SharedLocalizer["PeriodLabel"] :
                    </div>
                    <div class="col-12">
                        <select asp-for="SelectedPeriod" class="form-select" id="periodSelect" onchange="toggleCustomDates(this.value)">
                            <option value="all">@SharedLocalizer["AllPeriodsOption"]</option>
                            <option value="week">@SharedLocalizer["ThisWeekOption"]</option>
                            <option value="month">@SharedLocalizer["ThisMonthOption"]</option>
                            <option value="custom">@SharedLocalizer["CustomOption"]</option>
                        </select>
                    </div>
                    <div class="col-12" id="customDates" style="display:none;">
                        <div class="col">
                            <label asp-for="CustomStartDate" class="form-label">@SharedLocalizer["FromLabel"]</label>
                        </div>
                        <div class="col">
                            <input asp-for="CustomStartDate" type="date" class="form-control" />
                            <label asp-for="CustomEndDate" class="form-label">@SharedLocalizer["ToLabel"]</label>
                        </div>
                        <div class="col">
                            <input asp-for="CustomEndDate" type="date" class="form-control" />
                        </div>
                    </div>
                    <input type="hidden" asp-for="WeekOffset" />
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">@SharedLocalizer["SubmitButton"]</button>
                    </div>
                </form>
                <!-- Nouveau bouton Créer un utilisateur, aligné à droite du filtre -->
                <div class="position-absolute top-0 end-0">
                    <a asp-page="/Account/Register" class="btn btn-success">
                        <i class="bi bi-person-plus-fill me-2"></i>@SharedLocalizer["CreateEmployeeButton"]
                    </a>
                </div>
            </div>
        </div>

        <!-- 3. Sessions for Selected User -->
        <div class="col-lg-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        @SharedLocalizer["SessionsForLabel"]&nbsp;
                        @Model.AllEmployees.FirstOrDefault(e => e.Id == Model.SelectedEmployeeId)?.Username
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.SelectedEmployeeId != 0)
                    {
                        <!-- Bouton Ajouter TimeEntry -->
                        <div class="d-flex justify-content-end mb-3">
                            <a asp-page="/Admin/CreateTimeEntry"
                               asp-route-employeeId="@Model.SelectedEmployeeId"
                               asp-route-employeeUsername="@Model.AllEmployees.FirstOrDefault(e => e.Id == Model.SelectedEmployeeId)?.Username"
                               class="btn btn-success">
                                <i class="bi bi-plus-circle me-2"></i>@SharedLocalizer["AddTimeEntryButton"]
                            </a>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <form method="post" asp-page-handler="LoadSessions" style="display:inline;">
                                <input type="hidden" name="SelectedEmployeeId" value="@Model.SelectedEmployeeId" />
                                <input type="hidden" name="SelectedPeriod" value="@Model.SelectedPeriod" />
                                <input type="hidden" name="CustomStartDate" value="@(Model.CustomStartDate?.ToString("yyyy-MM-dd") ?? "")" />
                                <input type="hidden" name="CustomEndDate" value="@(Model.CustomEndDate?.ToString("yyyy-MM-dd") ?? "")" />
                                <input type="hidden" name="WeekOffset" value="@(Model.WeekOffset - 1)" />
                                <button type="submit" class="btn btn-link">&laquo; @SharedLocalizer["PreviousWeekButton"]</button>
                            </form>
                            <span>
                                @Model.CurrentWeekStart.ToString("dd/MM/yyyy") - @Model.CurrentWeekEnd.ToString("dd/MM/yyyy")
                            </span>
                            @if (Model.WeekOffset < 0)
                            {
                                <form method="post" asp-page-handler="LoadSessions" style="display:inline;">
                                    <input type="hidden" name="SelectedEmployeeId" value="@Model.SelectedEmployeeId" />
                                    <input type="hidden" name="SelectedPeriod" value="@Model.SelectedPeriod" />
                                    <input type="hidden" name="CustomStartDate" value="@(Model.CustomStartDate?.ToString("yyyy-MM-dd") ?? "")" />
                                    <input type="hidden" name="CustomEndDate" value="@(Model.CustomEndDate?.ToString("yyyy-MM-dd") ?? "")" />
                                    <input type="hidden" name="WeekOffset" value="@(Model.WeekOffset + 1)" />
                                    <button type="submit" class="btn btn-link">@SharedLocalizer["NextWeekButton"] &raquo;</button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-link text-muted" disabled>@SharedLocalizer["NextWeekButton"] &raquo;</button>
                            }
                        </div>
                    }
                    @if (Model.FilteredEntries != null && Model.FilteredEntries.Any())
                    {
                        <div class="table-responsive">
                            <!-- EXPORT BUTTON posts ALL filter info -->
                            <form method="post" asp-page-handler="ExportCsv" class="mt-3 text-end">
                                <input type="hidden" name="SelectedEmployeeId" value="@Model.SelectedEmployeeId" />
                                <input type="hidden" name="SelectedPeriod" value="@Model.SelectedPeriod" />
                                <input type="hidden" name="CustomStartDate" value="@(Model.CustomStartDate?.ToString("yyyy-MM-dd") ?? "")" />
                                <input type="hidden" name="CustomEndDate" value="@(Model.CustomEndDate?.ToString("yyyy-MM-dd") ?? "")" />
                                <button type="submit" class="btn btn-info">
                                    <i class="bi bi-download me-1"></i>@SharedLocalizer["ExportCsvButton"]
                                </button>
                            </form>
                            <table class="table table-striped align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>@SharedLocalizer["SessionTypeLabel"]</th>
                                        <th>@SharedLocalizer["StartTimeLabel"]</th>
                                        <th>@SharedLocalizer["EndTimeLabel"]</th>
                                        <th>@SharedLocalizer["WorkNetLabel"]</th>
                                        <th>@SharedLocalizer["IncludesTravelTimeLabel"]</th>
                                        <th>@SharedLocalizer["TravelTimeEstimateLabel"]</th>
                                        <th>@SharedLocalizer["StartAddressLabel"]</th>
                                        <th>@SharedLocalizer["EndAddressLabel"]</th>
                                        <th>@SharedLocalizer["DinnerPaidLabel"]</th>
                                        <th>@SharedLocalizer["ActionsLabel"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in Model.FilteredEntries)
                                    {
                                        <tr>
                                            <td>@SharedLocalizer[$"SessionType_{s.SessionType}"]</td>
                                            <td>
                                                <span class="dt-local" data-dt="@s.StartTime.ToString("o")"></span>
                                            </td>
                                            <td>
                                                @if (s.EndTime.HasValue)
                                                {
                                                    <span class="dt-local" data-dt="@s.EndTime.Value.ToString("o")"></span>
                                                }
                                                else
                                                {
                                                    <span>—</span>
                                                }
                                            </td>
                                            <td>@(s.WorkDurationNetFormatted ?? "—")</td>
                                            <td>@SharedLocalizer[s.IncludesTravelTime ? "YesLabel" : "NoLabel"]</td>
                                            <td>@(s.TravelTimeEstimate.HasValue? s.TravelTimeEstimate.Value.ToString(@"hh\:mm") : "—")</td>
                                            <td>@s.StartAddress</td>
                                            <td>@s.EndAddress</td>
                                            <td>@SharedLocalizer[$"DinnerPaidBy_{s.DinnerPaid}"]</td>
                                            <td>
                                                <a asp-page="/Admin/DetailsTimeEntry"
                                                   asp-route-id="@s.Id"
                                                   asp-route-employeeId="@Model.SelectedEmployeeId"
                                                   asp-route-period="@Model.SelectedPeriod"
                                                   asp-route-customStartDate="@(Model.CustomStartDate?.ToString("yyyy-MM-dd") ?? "")"
                                                   asp-route-customEndDate="@(Model.CustomEndDate?.ToString("yyyy-MM-dd") ?? "")"
                                                   asp-route-weekOffset="@Model.WeekOffset"
                                                   class="btn btn-sm btn-info"
                                                   title="@SharedLocalizer["DetailsButton"]">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                            <td>
                                                <a asp-page="/Admin/EditTimeEntry"
                                                   asp-route-id="@s.Id"
                                                   asp-route-employeeId="@Model.SelectedEmployeeId"
                                                   asp-route-period="@Model.SelectedPeriod"
                                                   asp-route-customStartDate="@(Model.CustomStartDate?.ToString("yyyy-MM-dd") ?? "")"
                                                   asp-route-customEndDate="@(Model.CustomEndDate?.ToString("yyyy-MM-dd") ?? "")"
                                                   asp-route-weekOffset="@Model.WeekOffset"
                                                   class="btn btn-sm btn-warning"
                                                   title="@SharedLocalizer["EditButton"]">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">@SharedLocalizer["NoSessionsMessage"]</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            function toggleCustomDates(val) {
                document.getElementById('customDates').style.display = val === 'custom' ? 'flex' : 'none';
            }
            document.addEventListener('DOMContentLoaded', function() {
                toggleCustomDates(document.getElementById('periodSelect').value);
                // Affichage des dates/horaires en heure locale du navigateur
                document.querySelectorAll('.dt-local').forEach(function (el) {
                    const raw = el.getAttribute('data-dt');
                    if (raw) {
                        const date = new Date(raw);
                        el.textContent = date.toLocaleString();
                    }
                });
            });
        </script>
    }
}
