@page
@model TimeTracker.AdminUI.Pages.Admin.AdminDashboardModel
@using Microsoft.Extensions.Localization
@using TimeTracker.Core.DTOs
@using TimeTracker.Core.Enums
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

@{
    ViewData["Title"] = SharedLocalizer["AdminDashboardTitle"];
}

@if (!(User?.Identity?.IsAuthenticated ?? false))
{
    <div class="alert alert-warning">
        <p>@SharedLocalizer["LoginRequiredMessage"]</p>
        <a href="/Account/Login" class="btn btn-primary">@SharedLocalizer["LoginButton"]</a>
    </div>
}
else if (!User.IsInRole("Admin"))
{
    <div class="alert alert-danger">
        <p>@SharedLocalizer["AccessDeniedMessage"]</p>
        <a href="/" class="btn btn-secondary">@SharedLocalizer["BackToHomeButton"]</a>
    </div>
}
else
{
    <style>
        /* Petit confort visuel */
        .filters-sticky {
            position: sticky;
            top: 0;
            z-index: 1020;
            background: #fff;
        }

        .flatpickr-input {
            background-color: #fff !important;
        }
    </style>

    <div class="row g-4">

        <!-- FILTRES -->
        <div class="col-lg-12">
            <div class="card shadow-sm">
                <div class="card-body">

                    <form method="post" asp-page-handler="LoadSessions" class="filters-sticky border rounded-3 p-3 mb-3">
                        <div class="row g-3 align-items-end">

                            <!-- Employé -->
                            <div class="col-12 col-lg-4">
                                <label class="form-label fw-semibold" for="employeeSelect">@SharedLocalizer["EmployeeLabel"]</label>
                                <select asp-for="SelectedEmployeeId" id="employeeSelect" class="form-select">
                                    <option value="0">-- @SharedLocalizer["SelectLabel"] --</option>
                                    @foreach (var emp in Model.AllEmployees)
                                    {
                                        <option value="@emp.Id">@emp.Username</option>
                                    }
                                </select>
                            </div>

                            <!-- Période -->
                            <div class="col-12 col-lg-5">
                                <label class="form-label fw-semibold">@SharedLocalizer["PeriodLabel"]</label>
                                <div class="btn-group w-100" role="group" aria-label="Period">
                                    <input type="radio" class="btn-check" name="SelectedPeriod" id="periodAll" value="all"
                                           @(Model.SelectedPeriod.Equals("all", StringComparison.OrdinalIgnoreCase) ? "checked" : null)>
                                    <label class="btn btn-outline-primary" for="periodAll">
                                        <i class="bi bi-grid"></i> @SharedLocalizer["AllPeriodsOption"]
                                    </label>

                                    <input type="radio" class="btn-check" name="SelectedPeriod" id="periodWeek" value="week"
                                           @(Model.SelectedPeriod.Equals("week", StringComparison.OrdinalIgnoreCase) ? "checked" : null)>
                                    <label class="btn btn-outline-primary" for="periodWeek">
                                        <i class="bi bi-calendar-week"></i> @SharedLocalizer["ThisWeekOption"]
                                    </label>

                                    <input type="radio" class="btn-check" name="SelectedPeriod" id="periodMonth" value="month"
                                           @(Model.SelectedPeriod.Equals("month", StringComparison.OrdinalIgnoreCase) ? "checked" : null)>
                                    <label class="btn btn-outline-primary" for="periodMonth">
                                        <i class="bi bi-calendar-month"></i> @SharedLocalizer["ThisMonthOption"]
                                    </label>

                                    <input type="radio" class="btn-check" name="SelectedPeriod" id="periodCustom" value="custom"
                                           @(Model.SelectedPeriod.Equals("custom", StringComparison.OrdinalIgnoreCase) ? "checked" : null)>
                                    <label class="btn btn-outline-primary" for="periodCustom">
                                        <i class="bi bi-sliders"></i> @SharedLocalizer["CustomOption"]
                                    </label>
                                </div>
                            </div>

                            <!-- Date range (Flatpickr) -->
                            <div class="col-12 col-lg-3" id="customRangeWrap" style="display:none;">
                                <label class="form-label fw-semibold">@SharedLocalizer["CustomOption"]</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-calendar-range"></i></span>
                                    <input id="dateRange" type="text" class="form-control"
                                           placeholder="@SharedLocalizer["FromLabel"] - @SharedLocalizer["ToLabel"]">
                                </div>
                                <!-- Hidden conservés pour le ModelBinding -->
                                <input type="hidden" asp-for="CustomStartDate" />
                                <input type="hidden" asp-for="CustomEndDate" />
                            </div>

                            <!-- Offsets -->
                            <input type="hidden" asp-for="WeekOffset" />
                            <input type="hidden" asp-for="MonthOffset" />

                            <!-- Soumettre -->
                            <div class="col-12 col-lg-12 text-end">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-filter-circle"></i> @SharedLocalizer["SubmitButton"]
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Bouton Créer un utilisateur -->
                    <div class="text-end">
                        <a asp-page="/Account/Register" class="btn btn-success">
                            <i class="bi bi-person-plus-fill me-2"></i>@SharedLocalizer["CreateEmployeeButton"]
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- NAVIGATION SEMAINE -->
        @if (Model.SelectedPeriod.Equals("week", StringComparison.OrdinalIgnoreCase) && Model.SelectedEmployeeId != 0)
        {
            <div class="col-lg-12">
                <div class="d-flex justify-content-between align-items-center">
                    <form method="post" asp-page-handler="LoadSessions" class="mb-0">
                        <input type="hidden" name="SelectedEmployeeId" value="@Model.SelectedEmployeeId" />
                        <input type="hidden" name="SelectedPeriod" value="week" />
                        <input type="hidden" name="CustomStartDate" value="@(Model.CustomStartDate?.ToString("yyyy-MM-dd") ?? "")" />
                        <input type="hidden" name="CustomEndDate" value="@(Model.CustomEndDate?.ToString("yyyy-MM-dd") ?? "")" />
                        <input type="hidden" name="WeekOffset" value="@(Model.WeekOffset - 1)" />
                        <input type="hidden" name="MonthOffset" value="@Model.MonthOffset" />
                        <button type="submit" class="btn btn-link">&laquo; @SharedLocalizer["PreviousWeekButton"]</button>
                    </form>

                    <span class="fw-semibold">
                        @Model.CurrentWeekStart.ToString("dd/MM/yyyy") - @Model.CurrentWeekEnd.ToString("dd/MM/yyyy")
                    </span>

                    <form method="post" asp-page-handler="LoadSessions" class="mb-0">
                        <input type="hidden" name="SelectedEmployeeId" value="@Model.SelectedEmployeeId" />
                        <input type="hidden" name="SelectedPeriod" value="week" />
                        <input type="hidden" name="CustomStartDate" value="@(Model.CustomStartDate?.ToString("yyyy-MM-dd") ?? "")" />
                        <input type="hidden" name="CustomEndDate" value="@(Model.CustomEndDate?.ToString("yyyy-MM-dd") ?? "")" />
                        <input type="hidden" name="WeekOffset" value="@(Model.WeekOffset + 1)" />
                        <input type="hidden" name="MonthOffset" value="@Model.MonthOffset" />
                        <button type="submit" class="btn btn-link">@SharedLocalizer["NextWeekButton"] &raquo;</button>
                    </form>
                </div>
            </div>
        }

        <!-- NAVIGATION MOIS -->
        @if (Model.SelectedPeriod.Equals("month", StringComparison.OrdinalIgnoreCase) && Model.SelectedEmployeeId != 0)
        {
            <div class="col-lg-12">
                <div class="d-flex justify-content-between align-items-center">
                    <form method="post" asp-page-handler="LoadSessions" class="mb-0">
                        <input type="hidden" name="SelectedEmployeeId" value="@Model.SelectedEmployeeId" />
                        <input type="hidden" name="SelectedPeriod" value="month" />
                        <input type="hidden" name="CustomStartDate" value="@(Model.CustomStartDate?.ToString("yyyy-MM-dd") ?? "")" />
                        <input type="hidden" name="CustomEndDate" value="@(Model.CustomEndDate?.ToString("yyyy-MM-dd") ?? "")" />
                        <input type="hidden" name="WeekOffset" value="@Model.WeekOffset" />
                        <input type="hidden" name="MonthOffset" value="@(Model.MonthOffset - 1)" />
                        <button type="submit" class="btn btn-link">&laquo; @SharedLocalizer["PreviousMonthButton"]</button>
                    </form>

                    <span class="fw-semibold">
                        @Model.CurrentMonthStart.ToString("dd/MM/yyyy") - @Model.CurrentMonthEnd.ToString("dd/MM/yyyy")
                    </span>

                    <form method="post" asp-page-handler="LoadSessions" class="mb-0">
                        <input type="hidden" name="SelectedEmployeeId" value="@Model.SelectedEmployeeId" />
                        <input type="hidden" name="SelectedPeriod" value="month" />
                        <input type="hidden" name="CustomStartDate" value="@(Model.CustomStartDate?.ToString("yyyy-MM-dd") ?? "")" />
                        <input type="hidden" name="CustomEndDate" value="@(Model.CustomEndDate?.ToString("yyyy-MM-dd") ?? "")" />
                        <input type="hidden" name="WeekOffset" value="@Model.WeekOffset" />
                        <input type="hidden" name="MonthOffset" value="@(Model.MonthOffset + 1)" />
                        <button type="submit" class="btn btn-link">@SharedLocalizer["NextMonthButton"] &raquo;</button>
                    </form>
                </div>
            </div>
        }

        <!-- LISTE DES SESSIONS -->
        <div class="col-lg-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light d-flex align-items-center justify-content-between">
                    <h5 class="mb-0">
                        @SharedLocalizer["SessionsForLabel"]&nbsp;
                        @Model.AllEmployees.FirstOrDefault(e => e.Id == Model.SelectedEmployeeId)?.Username
                    </h5>

                    <!-- Export CSV -->
                    @if (Model.FilteredEntries != null && Model.FilteredEntries.Any())
                    {
                        <form method="post" asp-page-handler="ExportCsv" class="mb-0">
                            <input type="hidden" name="SelectedEmployeeId" value="@Model.SelectedEmployeeId" />
                            <input type="hidden" name="SelectedPeriod" value="@Model.SelectedPeriod" />
                            <input type="hidden" name="CustomStartDate" value="@(Model.CustomStartDate?.ToString("yyyy-MM-dd") ?? "")" />
                            <input type="hidden" name="CustomEndDate" value="@(Model.CustomEndDate?.ToString("yyyy-MM-dd") ?? "")" />
                            <button type="submit" class="btn btn-sm btn-info">
                                <i class="bi bi-download me-1"></i>@SharedLocalizer["ExportCsvButton"]
                            </button>
                        </form>
                    }
                </div>

                <div class="card-body">
                    @if (Model.SelectedEmployeeId != 0)
                    {
                        <!-- Ajouter un TimeEntry -->
                        <div class="d-flex justify-content-end mb-3">
                            <a asp-page="/Admin/CreateTimeEntry"
                               asp-route-employeeId="@Model.SelectedEmployeeId"
                               asp-route-employeeUsername="@Model.AllEmployees.FirstOrDefault(e => e.Id == Model.SelectedEmployeeId)?.Username"
                               class="btn btn-success">
                                <i class="bi bi-plus-circle me-2"></i>@SharedLocalizer["AddTimeEntryButton"]
                            </a>
                        </div>
                    }

                    @if (Model.FilteredEntries != null && Model.FilteredEntries.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>@SharedLocalizer["SessionTypeLabel"]</th>
                                        <th>@SharedLocalizer["StartTimeLabel"]</th>
                                        <th>@SharedLocalizer["EndTimeLabel"]</th>
                                        <th>@SharedLocalizer["WorkNetLabel"]</th>
                                        <th class="text-center">@SharedLocalizer["IncludesTravelTimeLabel"]</th>
                                        <th>@SharedLocalizer["TravelTimeEstimateLabel"]</th>
                                        <th>@SharedLocalizer["StartAddressLabel"]</th>
                                        <th>@SharedLocalizer["EndAddressLabel"]</th>
                                        <th>@SharedLocalizer["DinnerPaidLabel"]</th>
                                        <th>@SharedLocalizer["ActionsLabel"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in Model.FilteredEntries)
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary">@SharedLocalizer[$"SessionType_{s.SessionType}"]</span></td>
                                            <td><span class="dt-local" data-dt="@s.StartTime.ToString("o")"></span></td>
                                            <td>
                                                @if (s.EndTime.HasValue)
                                                {
                                                    <span class="dt-local" data-dt="@s.EndTime.Value.ToString("o")"></span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td>@(s.WorkDurationNetFormatted ?? "—")</td>
                                            <td class="text-center">
                                                @if (s.IncludesTravelTime)
                                                {
                                                    <i class="bi bi-check-circle-fill text-success" aria-label="yes"></i>
                                                }
                                                else
                                                {

                                                    <i class="bi bi-x-circle-fill text-danger" aria-label="no"></i>
                                                }
                                            </td>
                                            <td>@(s.TravelTimeEstimate.HasValue? s.TravelTimeEstimate.Value.ToString(@"hh\:mm") : "—")</td>
                                            <td>@s.StartAddress</td>
                                            <td>@s.EndAddress</td>
                                            <td><span class="badge bg-light text-dark">@SharedLocalizer[$"DinnerPaidBy_{s.DinnerPaid}"]</span></td>
                                            <td class="text-nowrap">
                                                <a asp-page="/Admin/DetailsTimeEntry"
                                                   asp-route-id="@s.Id"
                                                   asp-route-employeeId="@Model.SelectedEmployeeId"
                                                   asp-route-period="@Model.SelectedPeriod"
                                                   asp-route-customStartDate="@(Model.CustomStartDate?.ToString("yyyy-MM-dd") ?? "")"
                                                   asp-route-customEndDate="@(Model.CustomEndDate?.ToString("yyyy-MM-dd") ?? "")"
                                                   asp-route-weekOffset="@Model.WeekOffset"
                                                   class="btn btn-sm btn-outline-info"
                                                   title="@SharedLocalizer["DetailsButton"]">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a asp-page="/Admin/EditTimeEntry"
                                                   asp-route-id="@s.Id"
                                                   asp-route-employeeId="@Model.SelectedEmployeeId"
                                                   asp-route-period="@Model.SelectedPeriod"
                                                   asp-route-customStartDate="@(Model.CustomStartDate?.ToString("yyyy-MM-dd") ?? "")"
                                                   asp-route-customEndDate="@(Model.CustomEndDate?.ToString("yyyy-MM-dd") ?? "")"
                                                   asp-route-weekOffset="@Model.WeekOffset"
                                                   class="btn btn-sm btn-outline-warning ms-1"
                                                   title="@SharedLocalizer["EditButton"]">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">@SharedLocalizer["NoSessionsMessage"]</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <!-- Flatpickr CSS (ok même en bas pour cette page) -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.css">
        <!-- Flatpickr JS -->
        <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
        <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/it.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/de.js"></script>

        <script>
            (function () {
                // Toggle custom range
                const customWrap = document.getElementById('customRangeWrap');
                function currentPeriod() {
                    const checked = document.querySelector('input[name="SelectedPeriod"]:checked');
                    return checked ? checked.value : "week";
                }
                function toggleCustom() {
                    const sel = currentPeriod();
                    customWrap.style.display = (sel === 'custom') ? 'block' : 'none';
                    // reset offsets selon le mode
                    if (sel === 'week')  document.querySelector('input[name="MonthOffset"]').value = 0;
                    if (sel === 'month') document.querySelector('input[name="WeekOffset"]').value  = 0;
                }
                document.querySelectorAll('input[name="SelectedPeriod"]').forEach(r => r.addEventListener('change', toggleCustom));
                toggleCustom();

                // Localisation Flatpickr
                const lang = (window.appCulture || '@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName').toLowerCase();
                const localeMap = { fr: flatpickr.l10ns.fr, it: flatpickr.l10ns.it, de: flatpickr.l10ns.de };
                const flLocale = localeMap[lang] || undefined;

                const startHidden = document.getElementById('CustomStartDate');
                const endHidden   = document.getElementById('CustomEndDate');

                // Flatpickr range
                const fp = flatpickr('#dateRange', {
                    mode: "range",
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: (lang === 'fr' || lang === 'it' || lang === 'de') ? "d/m/Y" : "m/d/Y",
                    locale: flLocale,
                    allowInput: true,
                    // Valeurs initiales si on revient sur la page
                    defaultDate: (startHidden.value && endHidden.value) ? [startHidden.value, endHidden.value] : null,
                    onChange: function(selectedDates) {
                        if (selectedDates.length === 2) {
                            const [start, end] = selectedDates;
                            const pad = n => (n < 10 ? '0' + n : '' + n);
                            const fmt = d => d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate());
                            startHidden.value = fmt(start);
                            endHidden.value   = fmt(end);
                        } else {
                            startHidden.value = "";
                            endHidden.value   = "";
                        }
                    }
                });

                // Affichage des dates/horaires en heure locale
                document.querySelectorAll('.dt-local').forEach(function (el) {
                    const raw = el.getAttribute('data-dt');
                    if (raw) el.textContent = new Date(raw).toLocaleString();
                });
            })();
        </script>
    }
}
