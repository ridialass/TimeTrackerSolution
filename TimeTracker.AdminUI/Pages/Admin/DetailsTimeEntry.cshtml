@page "{id:int}"
@model TimeTracker.AdminUI.Pages.Admin.DetailsTimeEntryModel
@using Microsoft.Extensions.Localization
@using TimeTracker.Core.Enums

@{
    ViewData["Title"] = SharedLocalizer["DetailTitle"];
    var entry = Model.TimeEntry;
}

<h2>@ViewData["Title"]</h2>

@if (entry != null)
{
    <div class="card mb-4">
        <div class="card-body">
            <dl class="row">
                <!-- UserId (hidden in CreatePage, shown for info here) -->
                <dt class="col-sm-3">@SharedLocalizer["IDWorker"]</dt>
                <dd class="col-sm-9">@entry.UserId</dd>

                <!-- Username -->
                <dt class="col-sm-3">@SharedLocalizer["RoleEmployee"]</dt>
                <dd class="col-sm-9">@entry.Username</dd>

                <!-- Start Time -->
                <dt class="col-sm-3">@SharedLocalizer["StartTimeLabel"]</dt>
                <dd class="col-sm-9">
                    <span class="dt-local" data-dt="@entry.StartTime.ToString("o")"></span>
                </dd>

                <!-- End Time -->
                <dt class="col-sm-3">@SharedLocalizer["EndTimeLabel"]</dt>
                <dd class="col-sm-9">
                    @if (entry.EndTime != null)
                    {
                        <span class="dt-local" data-dt="@entry.EndTime?.ToString("o")"></span>
                    }
                </dd>

                <!-- Session Type -->
                <dt class="col-sm-3">@SharedLocalizer["CsvSessionType"]</dt>
                <dd class="col-sm-9">@SharedLocalizer[$"SessionType_{entry.SessionType}"]</dd>

                <!-- Start Address -->
                <dt class="col-sm-3">@SharedLocalizer["CsvStartAddress"]</dt>
                <dd class="col-sm-9">@entry.StartAddress</dd>

                <!-- End Address -->
                <dt class="col-sm-3">@SharedLocalizer["CsvEndAddress"]</dt>
                <dd class="col-sm-9">@entry.EndAddress</dd>

                <!-- Includes Travel Time -->
                <dt class="col-sm-3">@SharedLocalizer["IncludesTravelTimeLabel"]</dt>
                <dd class="col-sm-9">
                    @(entry.IncludesTravelTime? SharedLocalizer["YesLabel"] : SharedLocalizer["NoLabel"])
                </dd>

                <!-- Travel Duration -->
                <dt class="col-sm-3">@SharedLocalizer["CsvTravelTime"]</dt>
                <dd class="col-sm-9">
                    @(Model.TravelDurationDisplay)
                </dd>

                <!-- Dinner Paid By -->
                <dt class="col-sm-3">@SharedLocalizer["DinnerPaid"]</dt>
                <dd class="col-sm-9">@SharedLocalizer[$"DinnerPaidBy_{entry.DinnerPaid}"]</dd>
            </dl>
            <a asp-page="/Admin/EditTimeEntry"
               asp-route-id="@entry.Id"
               asp-route-employeeId="@Model.EmployeeId"
               asp-route-period="@Model.Period"
               asp-route-customStartDate="@Model.CustomStartDate"
               asp-route-customEndDate="@Model.CustomEndDate"
               asp-route-weekOffset="@Model.WeekOffset"
               class="btn btn-warning">@SharedLocalizer["EditButton"]</a>
            <a asp-page="/Admin/AdminDashboard"
               asp-route-SelectedEmployeeId="@Model.EmployeeId"
               asp-route-SelectedPeriod="@Model.Period"
               asp-route-CustomStartDate="@Model.CustomStartDate"
               asp-route-CustomEndDate="@Model.CustomEndDate"
               asp-route-WeekOffset="@Model.WeekOffset"
               class="btn btn-secondary">@SharedLocalizer["BackButton"]</a>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">@SharedLocalizer["IDWorker"]Aucune donnée trouvée pour ce pointage.</div>
}

@section Scripts {
    <script>
        // Convert all .dt-local elements from UTC ISO to browser local date string
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.dt-local').forEach(function (el) {
                const raw = el.getAttribute('data-dt');
                if (raw) {
                    // Parse as UTC and display as local string
                    const date = new Date(raw);
                    el.textContent = date.toLocaleString();
                }
            });
        });
    </script>
}