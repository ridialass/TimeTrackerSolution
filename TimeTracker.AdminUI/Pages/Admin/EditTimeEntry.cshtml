@page "{id:int}"
@model TimeTracker.AdminUI.Pages.Admin.EditTimeEntryModel
@using Microsoft.Extensions.Localization
@using TimeTracker.Core.Enums

@{
    ViewData["Title"] = SharedLocalizer["EditTimeEntryTitle"];
}

<h2>@ViewData["Title"]</h2>

<form method="post">
    <span asp-validation-summary="All" class="text-danger"></span>
    <input type="hidden" asp-for="TimeEntry.Id" />
    <input type="hidden" asp-for="TimeEntry.UserId" />
    <input type="hidden" asp-for="TimeEntry.Username" />

    <!-- Start Time -->
    <div class="mb-3">
        <label class="form-label" for="startTimePicker">@SharedLocalizer["StartTimeLabel"]</label>
        <input id="startTimePicker"
               name="TimeEntry.StartTime"
               type="datetime-local"
               class="form-control"
               step="60"
               data-utc-value="@Model.TimeEntry.StartTime.ToString("o")"
               value=""
               autocomplete="off" />
        <span asp-validation-for="TimeEntry.StartTime" class="text-danger"></span>
    </div>

    <!-- End Time -->
    <div class="mb-3">
        <label class="form-label" for="endTimePicker">@SharedLocalizer["EndTimeLabel"]</label>
        <input id="endTimePicker"
               name="TimeEntry.EndTime"
               type="datetime-local"
               class="form-control"
               step="60"
               data-utc-value="@(Model.TimeEntry.EndTime.HasValue? Model.TimeEntry.EndTime.Value.ToString("o") : "")"
               value=""
               autocomplete="off" />
        <span asp-validation-for="TimeEntry.EndTime" class="text-danger"></span>
    </div>

    <!-- Pause rapide (heure/minute) -->
    <div class="mb-3">
        <label class="form-label">Durée totale des pauses (rapide)</label>
        <div class="row">
            <div class="col">
                <input type="number" min="0" max="12" class="form-control" name="PauseHours" value="@Model.PauseHours" placeholder="h" />
            </div>
            <div class="col">
                <input type="number" min="0" max="59" class="form-control" name="PauseMinutes" value="@Model.PauseMinutes" placeholder="min" />
            </div>
        </div>
        <span class="form-text text-warning">Si ce champ est rempli (&gt;0), il écrasera la liste manuelle des pauses.</span>
    </div>

    <!-- Pauses détaillées -->
    <div class="mb-3">
        <label class="form-label">Liste des pauses (début/fin)</label>
        <div id="pauses-list">
            @for (int i = 0; i < Model.TimeEntry.Pauses.Count; i++)
            {
                <div class="row mb-2 pause-row">
                    <div class="col">
                        <input type="datetime-local"
                               name="TimeEntry.Pauses[@i].Start"
                               class="form-control"
                               value="@(Model.TimeEntry.Pauses[i].Start.ToString("yyyy-MM-ddTHH:mm"))" />
                    </div>
                    <div class="col">
                        <input type="datetime-local"
                               name="TimeEntry.Pauses[@i].End"
                               class="form-control"
                               value="@(Model.TimeEntry.Pauses[i].End.HasValue ? Model.TimeEntry.Pauses[i].End.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-danger btn-remove-pause" onclick="removePause(this)">X</button>
                    </div>
                </div>
            }
        </div>
        <button type="button" class="btn btn-outline-primary mt-2" onclick="addPauseRow()">Ajouter une pause</button>
        <span class="form-text">Les pauses sont déduites du temps travaillé.</span>
    </div>

    <!-- Session Type -->
    <div class="mb-3">
        <label asp-for="TimeEntry.SessionType" class="form-label">@SharedLocalizer["SessionTypeLabel"]</label>
        <select asp-for="TimeEntry.SessionType" class="form-select">
            @foreach (WorkSessionType t in Enum.GetValues(typeof(WorkSessionType)))
            {
                <option value="@((int)t)">@SharedLocalizer[$"SessionType_{t}"]</option>
            }
        </select>
        <span asp-validation-for="TimeEntry.SessionType" class="text-danger"></span>
    </div>

    <!-- Start Address -->
    <div class="mb-3">
        <label asp-for="TimeEntry.StartAddress" class="form-label">@SharedLocalizer["StartAddressLabel"]</label>
        <input asp-for="TimeEntry.StartAddress" type="text" class="form-control" />
        <span asp-validation-for="TimeEntry.StartAddress" class="text-danger"></span>
    </div>

    <!-- End Address -->
    <div class="mb-3">
        <label asp-for="TimeEntry.EndAddress" class="form-label">@SharedLocalizer["EndAddressLabel"]</label>
        <input asp-for="TimeEntry.EndAddress" type="text" class="form-control" />
        <span asp-validation-for="TimeEntry.EndAddress" class="text-danger"></span>
    </div>

    <!-- Includes Travel Time -->
    <div class="mb-3 form-check">
        <input asp-for="TimeEntry.IncludesTravelTime" type="checkbox" class="form-check-input" />
        <label asp-for="TimeEntry.IncludesTravelTime" class="form-check-label">@SharedLocalizer["IncludesTravelTimeLabel"]</label>
        <span asp-validation-for="TimeEntry.IncludesTravelTime" class="text-danger"></span>
    </div>

    <!-- Travel Duration Hours -->
    <div class="mb-3">
        <label asp-for="TimeEntry.TravelDurationHours" class="form-label">@SharedLocalizer["TravelTimeEstimateLabel"]</label>
        <input asp-for="TimeEntry.TravelDurationHours" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="TimeEntry.TravelDurationHours" class="text-danger"></span>
    </div>

    <!-- Dinner Paid By -->
    <div class="mb-3">
        <label asp-for="TimeEntry.DinnerPaid" class="form-label">@SharedLocalizer["DinnerPaidLabel"]</label>
        <select asp-for="TimeEntry.DinnerPaid" class="form-select">
            @foreach (DinnerPaidBy d in Enum.GetValues(typeof(DinnerPaidBy)))
            {
                <option value="@((int)d)">@SharedLocalizer[$"DinnerPaidBy_{d}"]</option>
            }
        </select>
        <span asp-validation-for="TimeEntry.DinnerPaid" class="text-danger"></span>
    </div>

    <!-- Save and Cancel Buttons -->
    <button type="submit" class="btn btn-primary">@SharedLocalizer["SaveButton"]</button>
    <a asp-page="/Admin/AdminDashboard"
       asp-route-SelectedEmployeeId="@Model.EmployeeId"
       asp-route-SelectedPeriod="@Model.Period"
       class="btn btn-secondary">@SharedLocalizer["CancelButton"]</a>

    @if (Model.TimeEntry != null && Model.TimeEntry.Id > 0)
    {
        <button type="button" class="btn btn-danger" id="deleteEntryBtn">
            @SharedLocalizer["DeleteButton"]
        </button>
    }
</form>

@if (Model.TimeEntry != null && Model.TimeEntry.Id > 0)
{
    <form id="deleteEntryForm" method="post" asp-page-handler="Delete" style="display:none;">
        <input type="hidden" name="TimeEntry.Id" value="@Model.TimeEntry.Id" />
    </form>
}
@section Scripts {
    <script>
            // Formatte une date en yyyy-MM-ddTHH:mm
            function formatForDatetimeLocalInput(date) {
                const pad = n => n.toString().padStart(2, "0");
                return date.getFullYear() + "-" +
                    pad(date.getMonth() + 1) + "-" +
                    pad(date.getDate()) + "T" +
                    pad(date.getHours()) + ":" +
                    pad(date.getMinutes());
            }

            function setLocalDateTimeFromUtc(inputId) {
                var input = document.getElementById(inputId);
                if (input) {
                    var utcValue = input.getAttribute("data-utc-value");
                    if (utcValue) {
                        var date = new Date(utcValue);
                        if (!isNaN(date)) {
                            input.value = formatForDatetimeLocalInput(date);
                        }
                    }
                }
            }

            function attachDatePickerAutoClose(pickerId) {
                const picker = document.getElementById(pickerId);
                if (picker) {
                    let previousValue = picker.value;
                    picker.addEventListener('input', function () {
                        const currentValue = this.value;
                        if (previousValue && currentValue) {
                            const previousMinutes = previousValue.split(':')[1];
                            const currentMinutes = currentValue.split(':')[1];
                            if (previousMinutes !== currentMinutes) {
                                this.blur();
                            }
                        }
                        previousValue = currentValue;
                    });
                }
            }

            // Pauses dynamique
            function addPauseRow() {
                const idx = document.querySelectorAll('#pauses-list .pause-row').length;
                const html = `
                <div class="row mb-2 pause-row">
                    <div class="col">
                        <input type="datetime-local" name="TimeEntry.Pauses[${idx}].Start" class="form-control" />
                    </div>
                    <div class="col">
                        <input type="datetime-local" name="TimeEntry.Pauses[${idx}].End" class="form-control" />
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-danger btn-remove-pause" onclick="removePause(this)">X</button>
                    </div>
                </div>`;
                document.getElementById('pauses-list').insertAdjacentHTML('beforeend', html);
            }
            function removePause(btn) {
                btn.closest('.pause-row').remove();
            }
</script>
    <script>
        // Formatte une date en yyyy-MM-ddTHH:mm
        function formatForDatetimeLocalInput(date) {
            const pad = n => n.toString().padStart(2, "0");
            return date.getFullYear() + "-" +
                pad(date.getMonth() + 1) + "-" +
                pad(date.getDate()) + "T" +
                pad(date.getHours()) + ":" +
                pad(date.getMinutes());
        }

        // Remplit le champ à partir de l'attribut data-utc-value
        function setLocalDateTimeFromUtc(inputId) {
            var input = document.getElementById(inputId);
            if (input) {
                var utcValue = input.getAttribute("data-utc-value");
                if (utcValue) {
                    var date = new Date(utcValue);
                    if (!isNaN(date)) {
                        input.value = formatForDatetimeLocalInput(date);
                    }
                }
            }
        }

        // Auto-fermeture du datepicker à la sélection des minutes
        function attachDatePickerAutoClose(pickerId) {
            const picker = document.getElementById(pickerId);
            if (picker) {
                let previousValue = picker.value;
                picker.addEventListener('input', function () {
                    const currentValue = this.value;
                    if (previousValue && currentValue) {
                        const previousMinutes = previousValue.split(':')[1];
                        const currentMinutes = currentValue.split(':')[1];
                        if (previousMinutes !== currentMinutes) {
                            this.blur();
                        }
                    }
                    previousValue = currentValue;
                });
            }
        }

                document.addEventListener('DOMContentLoaded', function () {
            setLocalDateTimeFromUtc('startTimePicker');
            setLocalDateTimeFromUtc('endTimePicker');
            attachDatePickerAutoClose('startTimePicker');
            attachDatePickerAutoClose('endTimePicker');

            // LOG: Affiche la value JS au chargement
            var startValSpan = document.getElementById('startTimePickerValue');
            var endValSpan = document.getElementById('endTimePickerValue');
            var startInput = document.getElementById('startTimePicker');
            var endInput = document.getElementById('endTimePicker');
            if (startValSpan && startInput) {
                startValSpan.innerText = startInput.value;
            }
            if (endValSpan && endInput) {
                endValSpan.innerText = endInput.value;
            }

            // LOG: Affiche la value JS avant le submit
            document.querySelector('form').addEventListener('submit', function(e) {
                console.log('[Submit] startTimePicker value:', startInput ? startInput.value : "(absent)");
                console.log('[Submit] endTimePicker value:', endInput ? endInput.value : "(absent)");
            });

            // Confirmation suppression
            const deleteBtn = document.getElementById('deleteEntryBtn');
            if (deleteBtn) {
                deleteBtn.addEventListener('click', function () {
                    if (confirm('Êtes-vous sûr de vouloir supprimer cette entrée ?')) {
                        document.getElementById('deleteEntryForm').submit();
                    }
                });
            }
        });
    </script>
}

