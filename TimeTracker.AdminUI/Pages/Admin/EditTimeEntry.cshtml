@page "{id:int}"
@model TimeTracker.AdminUI.Pages.Admin.EditTimeEntryModel
@using Microsoft.Extensions.Localization
@using TimeTracker.Core.Enums

@{
    ViewData["Title"] = SharedLocalizer["EditTimeEntryTitle"];
}

<h2>@ViewData["Title"]</h2>

<form method="post">
    <span asp-validation-summary="All" class="text-danger"></span>
    <input type="hidden" asp-for="TimeEntry.Id" />
    <input type="hidden" asp-for="TimeEntry.UserId" />
    <input type="hidden" asp-for="TimeEntry.Username" />

    <!-- Start Time (Flatpickr + hidden) -->
    <div class="mb-3">
        <label class="form-label" for="startTimePickerDisplay">@SharedLocalizer["StartTimeLabel"]</label>
        <input id="startTimePickerDisplay"
               type="text"
               class="form-control"
               data-utc-value="@Model.TimeEntry.StartTime.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fff'Z'")"
               autocomplete="off" />
        <input id="startTimePickerHidden" name="TimeEntry.StartTime" type="hidden" value="" />
        <span class="text-muted small"></span>
        <span asp-validation-for="TimeEntry.StartTime" class="text-danger"></span>
    </div>

    <!-- End Time (Flatpickr + hidden) -->
    <div class="mb-3">
        <label class="form-label" for="endTimePickerDisplay">@SharedLocalizer["EndTimeLabel"]</label>
        <input id="endTimePickerDisplay"
               type="text"
               class="form-control"
               data-utc-value="@(Model.TimeEntry.EndTime.HasValue ? Model.TimeEntry.EndTime.Value.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fff'Z'") : "")"
               autocomplete="off" />
        <input id="endTimePickerHidden" name="TimeEntry.EndTime" type="hidden" value="" />
        <span class="text-muted small"></span>
        <span asp-validation-for="TimeEntry.EndTime" class="text-danger"></span>
    </div>

    <!-- Pause rapide -->
    <div class="mb-3">
        <label class="form-label">@SharedLocalizer["DuréeDesPausesRapide"]</label>
        <div class="row">
            <div class="col">
                <input type="number" min="0" max="12" class="form-control" name="PauseHours" value="@Model.PauseHours" placeholder="h" />
            </div>
            <div class="col">
                <input type="number" min="0" max="59" class="form-control" name="PauseMinutes" value="@Model.PauseMinutes" placeholder="min" />
            </div>
        </div>
        <span class="form-text text-warning"></span>
    </div>

    <!-- Pauses détaillées -->
    <div class="mb-3">
        <label class="form-label">@SharedLocalizer["ListeDesPauses"]</label>
        <div id="pauses-list">
            @for (int i = 0; i < Model.TimeEntry.Pauses.Count; i++)
            {
                <div class="row mb-2 pause-row">
                    <div class="col">
                        <input type="datetime-local"
                               name="TimeEntry.Pauses[@i].Start"
                               class="form-control"
                               value="@(Model.TimeEntry.Pauses[i].Start.ToString("yyyy-MM-ddTHH:mm"))" />
                    </div>
                    <div class="col">
                        <input type="datetime-local"
                               name="TimeEntry.Pauses[@i].End"
                               class="form-control"
                               value="@(Model.TimeEntry.Pauses[i].End.HasValue ? Model.TimeEntry.Pauses[i].End.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-danger btn-remove-pause" onclick="removePause(this)">X</button>
                    </div>
                </div>
            }
        </div>
        <button type="button" class="btn btn-outline-primary mt-2" onclick="addPauseRow()">@SharedLocalizer["AjouterUnePause"]</button>
        <span class="form-text">@SharedLocalizer["Indice di durata della pausa"]</span>
    </div>

    <!-- Session Type / Addresses / Travel / Dinner (inchangé) -->
    <div class="mb-3">
        <label asp-for="TimeEntry.SessionType" class="form-label">@SharedLocalizer["SessionTypeLabel"]</label>
        <select asp-for="TimeEntry.SessionType" class="form-select">
            @foreach (WorkSessionType t in Enum.GetValues(typeof(WorkSessionType)))
            {
                <option value="@((int)t)">@SharedLocalizer[$"SessionType_{t}"]</option>
            }
        </select>
        <span asp-validation-for="TimeEntry.SessionType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TimeEntry.StartAddress" class="form-label">@SharedLocalizer["StartAddressLabel"]</label>
        <input asp-for="TimeEntry.StartAddress" type="text" class="form-control" />
        <span asp-validation-for="TimeEntry.StartAddress" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TimeEntry.EndAddress" class="form-label">@SharedLocalizer["EndAddressLabel"]</label>
        <input asp-for="TimeEntry.EndAddress" type="text" class="form-control" />
        <span asp-validation-for="TimeEntry.EndAddress" class="text-danger"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="TimeEntry.IncludesTravelTime" type="checkbox" class="form-check-input" />
        <label asp-for="TimeEntry.IncludesTravelTime" class="form-check-label">@SharedLocalizer["IncludesTravelTimeLabel"]</label>
        <span asp-validation-for="TimeEntry.IncludesTravelTime" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TimeEntry.TravelDurationHours" class="form-label">@SharedLocalizer["TravelTimeEstimateLabel"]</label>
        <input asp-for="TimeEntry.TravelDurationHours" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="TimeEntry.TravelDurationHours" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TimeEntry.DinnerPaid" class="form-label">@SharedLocalizer["DinnerPaidLabel"]</label>
        <select asp-for="TimeEntry.DinnerPaid" class="form-select">
            @foreach (DinnerPaidBy d in Enum.GetValues(typeof(DinnerPaidBy)))
            {
                <option value="@((int)d)">@SharedLocalizer[$"DinnerPaidBy_{d}"]</option>
            }
        </select>
        <span asp-validation-for="TimeEntry.DinnerPaid" class="text-danger"></span>
    </div>

    <!-- Save / Cancel / Delete -->
    <button type="submit" class="btn btn-primary">@SharedLocalizer["SaveButton"]</button>
    <a asp-page="/Admin/AdminDashboard"
       asp-route-SelectedEmployeeId="@Model.EmployeeId"
       asp-route-SelectedPeriod="@Model.Period"
       class="btn btn-secondary">@SharedLocalizer["CancelButton"]</a>

    @if (Model.TimeEntry != null && Model.TimeEntry.Id > 0)
    {
        <button type="button" class="btn btn-danger" id="deleteEntryBtn">
            @SharedLocalizer["DeleteButton"]
        </button>
    }
</form>

@if (Model.TimeEntry != null && Model.TimeEntry.Id > 0)
{
    <form id="deleteEntryForm" method="post" asp-page-handler="Delete" style="display:none;">
        <input type="hidden" name="TimeEntry.Id" value="@Model.TimeEntry.Id" />
    </form>
}

@section Scripts {
    <script>
        // utilitaires
        function pad(n){ return n.toString().padStart(2,'0'); }
        function toLocalDatetimeLocalString(d){
          return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()) +
                 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
        }
        function parseUtcAttr(el){
          const iso = (el.getAttribute('data-utc-value') || '').trim();
          if(!iso) return null;
          // On ignore les dates "fantômes" (0001-01-01 etc.)
          if (/^0001-0?1-0?1/.test(iso)) return null;
          const d = new Date(iso);                   // ex: 2025-08-12T08:30:00.000Z
          if (isNaN(d)) return null;
          d.setSeconds(0,0);
          return d;
        }

        function wireFlatpickr(displayId, hiddenId, initialUtcDate){
          const display = document.getElementById(displayId);
          const hidden  = document.getElementById(hiddenId);

          const fp = flatpickr(display, {
            enableTime: true,
            time_24hr: true,
            minuteIncrement: 1,
            dateFormat: "Y-m-d H:i",        // affichage seulement
            onChange: function(selectedDates){
              if(!hidden) return;
              if(selectedDates && selectedDates[0]){
                const d = new Date(selectedDates[0].getTime());
                hidden.value = toLocalDatetimeLocalString(d); // ce que .NET attend
              } else {
                hidden.value = "";
              }
            }
          });

          // >>> Force l'initialisation depuis l'attribut data-utc-value
          if (initialUtcDate) {
            fp.setDate(initialUtcDate, true); // true => déclenche onChange -> alimente le hidden
          } else {
            // si pas de valeur côté serveur, on laisse vide (l'utilisateur choisira)
            if (hidden) hidden.value = "";
          }

          return fp;
        }

        document.addEventListener('DOMContentLoaded', function(){
          // START
          const startDisp = document.getElementById('startTimePickerDisplay');
          const startUtc  = parseUtcAttr(startDisp);
          const startFP   = wireFlatpickr('startTimePickerDisplay', 'startTimePickerHidden', startUtc);

          // END
          const endDisp = document.getElementById('endTimePickerDisplay');
          const endUtc  = parseUtcAttr(endDisp);
          const endFP   = wireFlatpickr('endTimePickerDisplay', 'endTimePickerHidden', endUtc);

          // Sécurité avant submit : si hidden est vide mais flatpickr a une date, on le remplit
          const form = document.querySelector('form');
          form.addEventListener('submit', function () {
            const hStart = document.getElementById('startTimePickerHidden');
            const hEnd   = document.getElementById('endTimePickerHidden');

            if (hStart && !hStart.value && startFP && startFP.selectedDates[0]) {
              hStart.value = toLocalDatetimeLocalString(startFP.selectedDates[0]);
            }
            if (hEnd && !hEnd.value && endFP && endFP.selectedDates[0]) {
              hEnd.value = toLocalDatetimeLocalString(endFP.selectedDates[0]);
            }
          });

          // Pauses (inchangé)
          window.addPauseRow = function(){
            const idx = document.querySelectorAll('#pauses-list .pause-row').length;
            const html = `
              <div class="row mb-2 pause-row">
                <div class="col">
                  <input type="datetime-local" name="TimeEntry.Pauses[${idx}].Start" class="form-control" />
                </div>
                <div class="col">
                  <input type="datetime-local" name="TimeEntry.Pauses[${idx}].End" class="form-control" />
                </div>
                <div class="col-auto">
                  <button type="button" class="btn btn-danger btn-remove-pause" onclick="removePause(this)">X</button>
                </div>
              </div>`;
            document.getElementById('pauses-list').insertAdjacentHTML('beforeend', html);
          };
          window.removePause = function(btn){ btn.closest('.pause-row').remove(); };

          const deleteBtn = document.getElementById('deleteEntryBtn');
          if (deleteBtn) {
            deleteBtn.addEventListener('click', function () {
              if (confirm('Êtes-vous sûr de vouloir supprimer cette entrée ?')) {
                document.getElementById('deleteEntryForm').submit();
              }
            });
          }
        });
    </script>
}

