@page
@model TimeTracker.AdminUI.Pages.Admin.CreateTimeEntryModel
@using Microsoft.Extensions.Localization
@using TimeTracker.Core.Enums

@{
    ViewData["Title"] = SharedLocalizer["CreateTimeEntryTitle"];
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<form method="post" class="card shadow-sm">
    <div class="card-body">
        <!-- UserId -->
        <input type="hidden" asp-for="TimeEntry.UserId" />
        <span asp-validation-for="TimeEntry.UserId" class="text-danger"></span>

        <!-- Username -->
        <input type="hidden" asp-for="TimeEntry.Username" />
        <span asp-validation-for="TimeEntry.Username" class="text-danger"></span>

        <!-- Start Time -->
        <div class="mb-3">
            <label class="form-label" for="startPicker">@SharedLocalizer["StartTimeLabel"]</label>

            <!-- champ visible (flatpickr) -->
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                <input id="startPicker"
                       type="text"
                       class="form-control"
                       placeholder="YYYY-MM-DD HH:mm"
                       autocomplete="off"
                       data-utc="@Model.TimeEntry.StartTime.ToString("O")" />
            </div>

            <!-- champ posté (bind Razor) -->
            <input asp-for="TimeEntry.StartTime" type="hidden" id="StartTimeHidden" />
            <span asp-validation-for="TimeEntry.StartTime" class="text-danger"></span>
        </div>

        <!-- Pause Duration (as h/min, mappée côté .cshtml.cs) -->
        <div class="mb-3">
            <label class="form-label">@SharedLocalizer["PauseDurationLabel"]</label>
            <div class="row g-2">
                <div class="col-6 col-md-3">
                    <div class="input-group">
                        <span class="input-group-text">h</span>
                        <input asp-for="PauseHours"
                               type="number"
                               class="form-control"
                               min="0" max="12" placeholder="hh" />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="input-group">
                        <span class="input-group-text">m</span>
                        <input asp-for="PauseMinutes"
                               type="number"
                               class="form-control"
                               min="0" max="59" placeholder="mm" />
                    </div>
                </div>
            </div>
            <div class="form-text">@SharedLocalizer["PauseDurationHint"]</div>
            <span asp-validation-for="PauseHours" class="text-danger"></span>
            <span asp-validation-for="PauseMinutes" class="text-danger"></span>
        </div>

        <!-- End Time -->
        <div class="mb-3">
            <label class="form-label" for="endPicker">@SharedLocalizer["EndTimeLabel"]</label>

            <!-- champ visible (flatpickr) -->
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-calendar2-event"></i></span>
                <input id="endPicker"
                       type="text"
                       class="form-control"
                       placeholder="YYYY-MM-DD HH:mm"
                       autocomplete="off"
                       data-utc="@(Model.TimeEntry.EndTime.HasValue? Model.TimeEntry.EndTime.Value.ToString("O") : "")" />
            </div>

            <!-- champ posté (bind Razor) -->
            <input asp-for="TimeEntry.EndTime" type="hidden" id="EndTimeHidden" />
            <span asp-validation-for="TimeEntry.EndTime" class="text-danger"></span>
        </div>

        <!-- Session Type -->
        <div class="mb-3">
            <label asp-for="TimeEntry.SessionType" class="form-label">@SharedLocalizer["SessionTypeLabel"]</label>
            <select asp-for="TimeEntry.SessionType" class="form-select">
                @foreach (WorkSessionType t in Enum.GetValues(typeof(WorkSessionType)))
                {
                    <option value="@((int)t)">@SharedLocalizer[$"SessionType_{t}"]</option>
                }
            </select>
            <span asp-validation-for="TimeEntry.SessionType" class="text-danger"></span>
        </div>

        <!-- Start Address -->
        <div class="mb-3">
            <label asp-for="TimeEntry.StartAddress" class="form-label">@SharedLocalizer["StartAddressLabel"]</label>
            <input asp-for="TimeEntry.StartAddress" type="text" class="form-control" />
            <span asp-validation-for="TimeEntry.StartAddress" class="text-danger"></span>
        </div>

        <!-- End Address -->
        <div class="mb-3">
            <label asp-for="TimeEntry.EndAddress" class="form-label">@SharedLocalizer["EndAddressLabel"]</label>
            <input asp-for="TimeEntry.EndAddress" type="text" class="form-control" />
            <span asp-validation-for="TimeEntry.EndAddress" class="text-danger"></span>
        </div>

        <!-- Includes Travel Time -->
        <div class="mb-3 form-check">
            <input asp-for="TimeEntry.IncludesTravelTime" type="checkbox" class="form-check-input" id="IncludesTravel" />
            <label asp-for="TimeEntry.IncludesTravelTime" class="form-check-label">@SharedLocalizer["IncludesTravelTimeLabel"]</label>
            <span asp-validation-for="TimeEntry.IncludesTravelTime" class="text-danger"></span>
        </div>

        <!-- Travel Duration (hh:mm -> hidden hours double) -->
        <div class="mb-3" id="travelGroup">
            <label class="form-label">@SharedLocalizer["TravelTimeEstimateLabel"]</label>
            <div class="row g-2">
                <div class="col-6 col-md-3">
                    <div class="input-group">
                        <span class="input-group-text">h</span>
                        <input id="TravelHours" type="number" class="form-control" min="0" max="24" placeholder="hh" />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="input-group">
                        <span class="input-group-text">m</span>
                        <input id="TravelMinutes" type="number" class="form-control" min="0" max="59" placeholder="mm" />
                    </div>
                </div>
            </div>

            <!-- champ posté attendu par le backend (double? heures) -->
            <input asp-for="TimeEntry.TravelDurationHours" type="hidden" id="TravelDurationHidden" />
            <span asp-validation-for="TimeEntry.TravelDurationHours" class="text-danger"></span>
        </div>

        <!-- Dinner Paid By -->
        <div class="mb-3">
            <label asp-for="TimeEntry.DinnerPaid" class="form-label">@SharedLocalizer["DinnerPaidLabel"]</label>
            <select asp-for="TimeEntry.DinnerPaid" class="form-select">
                @foreach (DinnerPaidBy d in Enum.GetValues(typeof(DinnerPaidBy)))
                {
                    <option value="@((int)d)">@SharedLocalizer[$"DinnerPaidBy_{d}"]</option>
                }
            </select>
            <span asp-validation-for="TimeEntry.DinnerPaid" class="text-danger"></span>
        </div>
    </div>

    <div class="card-footer d-flex gap-2">
        <button type="submit" class="btn btn-success">
            <i class="bi bi-check2-circle me-1"></i>@SharedLocalizer["CreateButton"]
        </button>
        <a asp-page="/Admin/AdminDashboard"
           asp-route-employeeId="@Model.SelectedEmployeeId"
           class="btn btn-secondary">
            <i class="bi bi-x-circle me-1"></i>@SharedLocalizer["CancelButton"]
        </a>
    </div>
</form>

@section Scripts {
    <!-- Flatpickr (date & time) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/it.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/de.js"></script>

    <script>
        (function () {
            // Culture -> flatpickr locale
            const lang = (window.appCulture || '@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName').toLowerCase();
            const localeMap = { fr: flatpickr.l10ns.fr, it: flatpickr.l10ns.it, de: flatpickr.l10ns.de };
            const flLocale = localeMap[lang] || undefined;

            // Utilitaires
            const pad = n => (n < 10 ? '0' + n : '' + n);
            const formatInput = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());

            // Champs visibles & hidden
            const startPicker = document.getElementById('startPicker');
            const endPicker = document.getElementById('endPicker');
            const startHidden = document.getElementById('StartTimeHidden');
            const endHidden = document.getElementById('EndTimeHidden');

            // Par défaut, si le hidden contient une valeur, on la pousse dans l'affichage (sinon on tente data-utc)
            const startIso = startPicker.getAttribute('data-utc');
            const endIso = endPicker.getAttribute('data-utc');

            const fpStart = flatpickr(startPicker, {
                enableTime: true,
                time_24hr: true,
                dateFormat: "Y-m-d H:i",
                altInput: true,
                altFormat: (lang === 'fr' || lang === 'it' || lang === 'de') ? "d/m/Y H:i" : "m/d/Y h:i K",
                locale: flLocale,
                defaultDate: startHidden.value ? startHidden.value.replace('T', ' ') :
                             (startIso ? new Date(startIso) : null),
                minuteIncrement: 5,
                onChange: function (selectedDates) {
                    if (selectedDates.length) startHidden.value = formatInput(selectedDates[0]);
                    else startHidden.value = "";
                }
            });

            const fpEnd = flatpickr(endPicker, {
                enableTime: true,
                time_24hr: true,
                dateFormat: "Y-m-d H:i",
                altInput: true,
                altFormat: (lang === 'fr' || lang === 'it' || lang === 'de') ? "d/m/Y H:i" : "m/d/Y h:i K",
                locale: flLocale,
                defaultDate: endHidden.value ? endHidden.value.replace('T', ' ') :
                             (endIso ? new Date(endIso) : null),
                minuteIncrement: 5,
                onChange: function (selectedDates) {
                    if (selectedDates.length) endHidden.value = formatInput(selectedDates[0]);
                    else endHidden.value = "";
                }
            });

            // Gestion du temps de déplacement
            const includesTravel = document.getElementById('IncludesTravel');
            const travelGroup = document.getElementById('travelGroup');
            const travelHours = document.getElementById('TravelHours');
            const travelMinutes = document.getElementById('TravelMinutes');
            const travelHidden = document.getElementById('TravelDurationHidden');

            function syncTravelHidden() {
                if (!includesTravel.checked) {
                    travelHidden.value = "";  // null côté serveur
                    travelHours.value = "";
                    travelMinutes.value = "";
                    travelHours.disabled = true;
                    travelMinutes.disabled = true;
                    travelGroup.classList.add('opacity-50');
                    return;
                }
                travelHours.disabled = false;
                travelMinutes.disabled = false;
                travelGroup.classList.remove('opacity-50');

                const h = parseInt(travelHours.value || "0", 10);
                const m = parseInt(travelMinutes.value || "0", 10);
                if (h >= 0 && m >= 0 && m < 60) {
                    travelHidden.value = (h + (m / 60)).toFixed(2); // double en heures
                } else {
                    travelHidden.value = "";
                }
            }
            includesTravel.addEventListener('change', syncTravelHidden);
            travelHours.addEventListener('input', syncTravelHidden);
            travelMinutes.addEventListener('input', syncTravelHidden);
            syncTravelHidden();

            // Auto-fermeture "à la sélection des minutes" (UX +)
            function autoCloseOnMinute(pickerInput, fpInstance) {
                let last = "";
                pickerInput.addEventListener('input', function () {
                    if (!this.value) return;
                    const now = this.value;
                    const lastMin = last.split(':')[1];
                    const curMin = now.split(':')[1];
                    if (last && curMin && lastMin !== curMin) {
                        fpInstance.close();
                    }
                    last = now;
                });
            }
            autoCloseOnMinute(startPicker, fpStart);
            autoCloseOnMinute(endPicker, fpEnd);
        })();
    </script>
}
