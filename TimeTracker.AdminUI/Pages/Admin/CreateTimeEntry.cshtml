@page
@model TimeTracker.AdminUI.Pages.Admin.CreateTimeEntryModel
@using Microsoft.Extensions.Localization
@using TimeTracker.Core.Enums

@{
    ViewData["Title"] = SharedLocalizer["CreateTimeEntryTitle"];
}

<h2>@ViewData["Title"]</h2>

<form method="post">
    <!-- UserId / Username -->
    <input type="hidden" asp-for="TimeEntry.UserId" />
    <span asp-validation-for="TimeEntry.UserId" class="text-danger"></span>
    <input type="hidden" asp-for="TimeEntry.Username" />
    <span asp-validation-for="TimeEntry.Username" class="text-danger"></span>

    <!-- Start Time (Flatpickr visible + hidden pour le binder) -->
    <div class="mb-3">
        <label class="form-label" for="startTimePickerDisplay">@SharedLocalizer["StartTimeLabel"]</label>
        <input id="startTimePickerDisplay"
               type="text"
               class="form-control"
               data-utc-value="@Model.TimeEntry.StartTime.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fff'Z'")"
               autocomplete="off" />
        <input id="startTimePickerHidden" name="TimeEntry.StartTime" type="hidden" value="" />
        <span class="text-muted small"></span>
        <span asp-validation-for="TimeEntry.StartTime" class="text-danger"></span>
    </div>

    <!-- Pause Duration (h/min) -->
    <div class="mb-3">
        <label class="form-label">@SharedLocalizer["PauseDurationLabel"]</label>
        <div class="row">
            <div class="col">
                <input asp-for="PauseHours" type="number" class="form-control" min="0" max="12" placeholder="h" />
            </div>
            <div class="col">
                <input asp-for="PauseMinutes" type="number" class="form-control" min="0" max="59" placeholder="min" />
            </div>
        </div>
        <span class="form-text">@SharedLocalizer["PauseDurationHint"]</span>
        <span asp-validation-for="PauseHours" class="text-danger"></span>
        <span asp-validation-for="PauseMinutes" class="text-danger"></span>
    </div>

    <!-- End Time (Flatpickr + hidden) -->
    <div class="mb-3">
        <label class="form-label" for="endTimePickerDisplay">@SharedLocalizer["EndTimeLabel"]</label>
        <input id="endTimePickerDisplay"
               type="text"
               class="form-control"
               data-utc-value="@(Model.TimeEntry.EndTime.HasValue? Model.TimeEntry.EndTime.Value.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fff'Z'") : "")"
               autocomplete="off" />
        <input id="endTimePickerHidden" name="TimeEntry.EndTime" type="hidden" value="" />
        <span class="text-muted small"></span>
        <span asp-validation-for="TimeEntry.EndTime" class="text-danger"></span>
    </div>

    <!-- Session Type -->
    <div class="mb-3">
        <label asp-for="TimeEntry.SessionType" class="form-label">@SharedLocalizer["SessionTypeLabel"]</label>
        <select asp-for="TimeEntry.SessionType" class="form-select">
            @foreach (WorkSessionType t in Enum.GetValues(typeof(WorkSessionType)))
            {
                <option value="@((int)t)">@SharedLocalizer[$"SessionType_{t}"]</option>
            }
        </select>
        <span asp-validation-for="TimeEntry.SessionType" class="text-danger"></span>
    </div>

    <!-- Start / End Address -->
    <div class="mb-3">
        <label asp-for="TimeEntry.StartAddress" class="form-label">@SharedLocalizer["StartAddressLabel"]</label>
        <input asp-for="TimeEntry.StartAddress" type="text" class="form-control" />
        <span asp-validation-for="TimeEntry.StartAddress" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TimeEntry.EndAddress" class="form-label">@SharedLocalizer["EndAddressLabel"]</label>
        <input asp-for="TimeEntry.EndAddress" type="text" class="form-control" />
        <span asp-validation-for="TimeEntry.EndAddress" class="text-danger"></span>
    </div>

    <!-- Includes Travel Time -->
    <div class="mb-3 form-check">
        <input asp-for="TimeEntry.IncludesTravelTime" type="checkbox" class="form-check-input" />
        <label asp-for="TimeEntry.IncludesTravelTime" class="form-check-label">@SharedLocalizer["IncludesTravelTimeLabel"]</label>
        <span asp-validation-for="TimeEntry.IncludesTravelTime" class="text-danger"></span>
    </div>

    <!-- Travel Duration Hours -->
    <div class="mb-3">
        <label asp-for="TimeEntry.TravelDurationHours" class="form-label">@SharedLocalizer["TravelTimeEstimateLabel"]</label>
        <input asp-for="TimeEntry.TravelDurationHours" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="TimeEntry.TravelDurationHours" class="text-danger"></span>
    </div>

    <!-- Dinner Paid By -->
    <div class="mb-3">
        <label asp-for="TimeEntry.DinnerPaid" class="form-label">@SharedLocalizer["DinnerPaidLabel"]</label>
        <select asp-for="TimeEntry.DinnerPaid" class="form-select">
            @foreach (DinnerPaidBy d in Enum.GetValues(typeof(DinnerPaidBy)))
            {
                <option value="@((int)d)">@SharedLocalizer[$"DinnerPaidBy_{d}"]</option>
            }
        </select>
        <span asp-validation-for="TimeEntry.DinnerPaid" class="text-danger"></span>
    </div>

    <!-- Buttons -->
    <button type="submit" class="btn btn-success">@SharedLocalizer["CreateButton"]</button>
    <a asp-page="/Admin/AdminDashboard"
       asp-route-employeeId="@Model.SelectedEmployeeId"
       class="btn btn-secondary">@SharedLocalizer["CancelButton"]</a>
</form>

@section Scripts {
    <script>
        // formateur pour hidden: yyyy-MM-ddTHH:mm
        function pad(n){ return n.toString().padStart(2,'0'); }
        function toLocalDatetimeLocalString(d){
          return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()) +
                 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
        }
        function parseDefault(el, fallbackNow){
          const iso = (el.getAttribute('data-utc-value')||'').trim();
          let d = iso ? new Date(iso) : null;
          if(d && isNaN(d)) d = null;
          if(!d && fallbackNow){ d = new Date(); }
          if(d){ d.setSeconds(0,0); }
          return d;
        }

        document.addEventListener('DOMContentLoaded', function(){
          const fpOptsCreate = {
            enableTime: true, time_24hr: true, minuteIncrement: 1,
            dateFormat: "Y-m-d H:i",
            onChange: function(selectedDates, dateStr, instance){
              const h = document.getElementById(instance._input.id === 'startTimePickerDisplay'
                        ? 'startTimePickerHidden' : 'endTimePickerHidden');
              if(h){
                if(selectedDates && selectedDates[0]){
                  const d = new Date(selectedDates[0].getTime());
                  h.value = toLocalDatetimeLocalString(d);  // binder friendly
                }else{
                  h.value = "";
                }
              }
            },
            onReady: function(selectedDates, dateStr, instance){
              // initial sync
              this.config.onChange.call(this, selectedDates, dateStr, instance);
            }
          };

          // START: fallback = maintenant si vide
          const startInput = document.getElementById('startTimePickerDisplay');
          const startDefault = parseDefault(startInput, /*fallbackNow*/ true);
          if(startDefault){ fpOptsCreate.defaultDate = startDefault; }
          flatpickr(startInput, fpOptsCreate);

          // END: pas de fallback (on laisse vide si non fourni)
          const endInput = document.getElementById('endTimePickerDisplay');
          const endDefault = parseDefault(endInput, /*fallbackNow*/ false);
          const endOpts = Object.assign({}, fpOptsCreate);
          if(endDefault){ endOpts.defaultDate = endDefault; } else { endOpts.defaultDate = null; }
          flatpickr(endInput, endOpts);
        });
    </script>
}
